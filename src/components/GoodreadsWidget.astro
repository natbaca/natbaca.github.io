    image:
      "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1513265126l/33986067._SX98_.jpg",
  },
  {
    title: "Dungeon Crawler Carl (Dungeon Crawler Carl, #1)",
    href: "https://www.goodreads.com/book/show/211721806-dungeon-crawler-carl",
    image:
      "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1715780755l/211721806._SX98_.jpg",
  },
  {
    title: "First Language Acquisition",
    href: "https://www.goodreads.com/book/show/211963675-first-language-acquisition",
