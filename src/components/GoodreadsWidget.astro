---

<Card className="reading-section gap-0 overflow-visible py-0">
  <CardHeader className="px-5 pt-5 pb-2">
    <CardTitle role="heading" aria-level={2}>Reading</CardTitle>
  </CardHeader>
  <CardContent className="reading-shelf px-5 pb-5">
    <div class="shelf-block">
      <div class="shelf-heading">
        <p class="shelf-label">Currently reading</p>
        <a class="shelf-link" href={currentlyReadingShelfUrl}>Shelf ↗</a>
      </div>
      <div class="goodreads-shell currently-reading-shell">
        <div id="gr_grid_widget_1785770750">
          <div class="gr_grid_container">
            {
              currentlyReadingBooks.map((book) => (
                <div class="gr_grid_book_container">
                  <a title={book.title} rel="nofollow" href={book.href}>
                    <img
                      alt={`Cover of ${book.title}`}
                      src={book.image}
                      width="98"
                      height="147"
                      loading="lazy"
                    />
                  </a>
                </div>
              ))
            }
          </div>
        </div>
        <script is:inline src={currentlyReadingWidgetUrl}></script>
        <noscript>
          <p>
            <a href={currentlyReadingShelfUrl}
              >See what I'm currently reading on Goodreads.</a
            >
          </p>
        </noscript>
      </div>
    </div>

    <div class="shelf-block">
      <div class="shelf-heading">
        <p class="shelf-label">Recently read</p>
        <a class="shelf-link" href={readShelfUrl}>Shelf ↗</a>
      </div>
      <div class="goodreads-shell recently-read-shell">
        <div id="gr_custom_widget_1785276567">
          <div class="gr_custom_container_1785276566">
            <h2 class="gr_custom_header_1785276566">
              <a rel="nofollow" href={readShelfUrl}>Nat's bookshelf: read</a>
            </h2>
            {
              fallbackBooks.map((book) => (
                <div class="gr_custom_each_container_1785276566">
                  <div class="gr_custom_book_container_1785276566">
                    <a title={book.title} rel="nofollow" href={book.href}>
                      <img
                        alt={`Cover of ${book.title}`}
                        src={book.image}
                        width="98"
                        height="147"
                        loading="lazy"
                      />
                    </a>
                  </div>
                  <div class="gr_custom_title_1785276566">
                    <a rel="nofollow" href={book.href}>
                      {book.title}
                    </a>
                  </div>
                  <div class="gr_custom_author_1785276566">
                    by {book.author}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <script is:inline src={readWidgetUrl}></script>
        <noscript>
          <p>
            <a href={readShelfUrl}
              >See the books I've read recently on Goodreads.</a
            >
          </p>
        </noscript>
      </div>
    </div>
  </CardContent>
</Card>

<style>
  .reading-shelf {
    display: grid;
    gap: 1.15rem;
    min-width: 0;
  }

  .shelf-block {
    min-width: 0;
  }

  .shelf-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
  }

  .shelf-label {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .shelf-link {
    color: var(--foreground);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
  }

  .shelf-link:hover {
    text-decoration: underline;
  }

  .goodreads-shell {
    width: 100%;
    min-width: 0;
    overflow: visible;
  }

  .currently-reading-shell :global(.gr_grid_container),
  .currently-reading-shell :global([class^="gr_grid_container"]),
  .recently-read-shell :global([class^="gr_custom_container_"]) {
    display: grid !important;
    /* 4 cols: fills the sidebar without oversized covers / tall overflow */
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    justify-items: stretch !important;
    gap: 0.45rem !important;
    width: 100% !important;
    max-width: 100% !important;
    padding: 0 !important;
    border: 0 !important;
    background: transparent !important;
    overflow: visible !important;
  }

  .currently-reading-shell :global(.gr_grid_container > h2),
  .currently-reading-shell :global(.gr_grid_container > br),
  .currently-reading-shell :global(.gr_grid_branding),
  .currently-reading-shell :global(#gr_grid_widget_1785770750 > h2),
  .recently-read-shell :global([class^="gr_custom_header_"]),
  .recently-read-shell :global([class^="gr_custom_container_"] > br),
  .recently-read-shell :global([class^="gr_custom_container_"] > center) {
    display: none !important;
  }

  .currently-reading-shell :global(.gr_grid_book_container),
  .recently-read-shell :global([class^="gr_custom_each_container_"]) {
    display: flex !important;
    float: none !important;
    justify-content: stretch !important;
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    overflow: visible !important;
  }

  .currently-reading-shell :global(.gr_grid_book_container a),
  .recently-read-shell :global([class^="gr_custom_book_container_"]) {
    display: block !important;
    float: none !important;
    /* Fill the 4-col cell; shorter/safer than the previous 3-col stretch */
    width: 100% !important;
    max-width: 100% !important;
    aspect-ratio: 2 / 3 !important;
    height: auto !important;
    max-height: none !important;
    overflow: hidden !important;
    border-radius: 0.3rem !important;
    background: var(--muted) !important;
    box-shadow: 0 1px 2px oklch(0.2 0.02 70 / 0.08);
  }

  .currently-reading-shell :global(.gr_grid_book_container img),
  .recently-read-shell :global([class^="gr_custom_book_container_"] img) {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    object-fit: cover !important;
    border: 0 !important;
  }

  .currently-reading-shell :global(.gr_grid_container::after),
  .currently-reading-shell :global([class^="gr_grid_container"]::after),
  .recently-read-shell :global([class^="gr_custom_title_"]),
  .recently-read-shell :global([class^="gr_custom_author_"]),
  .recently-read-shell :global([class^="gr_custom_tags_"]),
  .recently-read-shell :global([class^="gr_custom_rating_"]) {
    display: none !important;
  }

  noscript p {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
  }

  /* Full-width reading card: more columns so covers stay moderate */
  @media (max-width: 900px) {
    .currently-reading-shell :global(.gr_grid_container),
    .currently-reading-shell :global([class^="gr_grid_container"]),
    .recently-read-shell :global([class^="gr_custom_container_"]) {
      grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
      gap: 0.5rem !important;
    }
  }

  @media (max-width: 480px) {
    .currently-reading-shell :global(.gr_grid_container),
    .currently-reading-shell :global([class^="gr_grid_container"]),
    .recently-read-shell :global([class^="gr_custom_container_"]) {
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      gap: 0.4rem !important;
    }
  }
</style>
