---
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";

const readShelfUrl =
  "https://www.goodreads.com/review/list/12688292-nat-baca?shelf=read&utm_medium=api&utm_source=custom_widget";
const readWidgetUrl =
  "https://www.goodreads.com/review/custom_widget/12688292.Nat's%20bookshelf:%20read?cover_position=left&cover_size=small&num_books=8&order=d&shelf=read&show_author=1&show_cover=1&show_rating=0&show_review=0&show_tags=0&show_title=1&sort=date_added&widget_bg_color=FFFFFF&widget_bg_transparent=&widget_border_width=0&widget_id=1785276567&widget_text_color=000000&widget_title_size=medium&widget_width=medium";

const currentlyReadingShelfUrl =
  "https://www.goodreads.com/review/list/12688292-nat-baca?shelf=currently-reading&utm_medium=api&utm_source=grid_widget";
const currentlyReadingWidgetUrl =
  "https://www.goodreads.com/review/grid_widget/12688292.Nat's%20currently-reading%20book%20montage?cover_size=medium&hide_link=&hide_title=&num_books=8&order=d&shelf=currently-reading&sort=date_added&widget_id=1785770750";

