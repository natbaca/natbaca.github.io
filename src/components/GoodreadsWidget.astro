    image:
      "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1660049617l/61897954._SX98_.jpg",
  },
  {
    title:
      "And Baby Makes Three: The Six-Step Plan for Preserving Marital Intimacy and Rekindling Romance After Baby Arrives",
    href: "https://www.goodreads.com/book/show/133572.And_Baby_Makes_Three",
    image:
      "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1429154386l/133572._SX98_.jpg",
  },
];

