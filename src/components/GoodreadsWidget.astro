  {
    title: "The Penelopiad",
    author: "Margaret Atwood",
    href: "https://www.goodreads.com/review/show/8803272239?utm_medium=api&utm_source=custom_widget",
    image:
      "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1442806554l/17645._SX98_.jpg",
  },
  {
    title: "Joyride: A Memoir",
    author: "Susan Orlean",
