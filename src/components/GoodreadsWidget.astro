---
const shelfUrl =
  "https://www.goodreads.com/review/list/12688292-nat-baca?shelf=read&utm_medium=api&utm_source=custom_widget";
const widgetUrl =
  "https://www.goodreads.com/review/custom_widget/12688292.Nat's%20bookshelf:%20read?cover_position=left&cover_size=small&num_books=8&order=d&shelf=read&show_author=1&show_cover=1&show_rating=0&show_review=0&show_tags=0&show_title=1&sort=date_added&widget_bg_color=FFFFFF&widget_bg_transparent=&widget_border_width=0&widget_id=1785276567&widget_text_color=000000&widget_title_size=medium&widget_width=medium";

const fallbackBooks = [
  {
    title: "The Penelopiad",
    author: "Margaret Atwood",
    href: "https://www.goodreads.com/review/show/8803272239?utm_medium=api&utm_source=custom_widget",
    image:
      "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1442806554l/17645._SY75_.jpg",
  },
  {
    title: "Joyride: A Memoir",
    author: "Susan Orlean",
    href: "https://www.goodreads.com/review/show/8794942036?utm_medium=api&utm_source=custom_widget",
    image:
      "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1745431576l/224003864._SX50_.jpg",
  },
  {
    title: "Dubliners (Norton Critical Editions)",
    author: "James Joyce",
    href: "https://www.goodreads.com/review/show/8791380678?utm_medium=api&utm_source=custom_widget",
    image:
      "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1698718415l/148419014._SY75_.jpg",
  },
  {
    title: "Fever Beach",
    author: "Carl Hiaasen",
    href: "https://www.goodreads.com/review/show/8787040054?utm_medium=api&utm_source=custom_widget",
    image:
      "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1733071007l/217245548._SX50_.jpg",
  },
  {
    title: "The Library Book",
    author: "Susan Orlean",
    href: "https://www.goodreads.com/review/show/8776929392?utm_medium=api&utm_source=custom_widget",
    image:
      "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1599591284l/39507318._SY75_.jpg",
  },
  {
    title: "Furious Minds",
    author: "Laura K. Field",
    href: "https://www.goodreads.com/review/show/8771300053?utm_medium=api&utm_source=custom_widget",
    image:
      "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1747306970l/230169545._SY75_.jpg",
  },
  {
    title: "Yesteryear",
    author: "Caro Claire Burke",
    href: "https://www.goodreads.com/review/show/8765265039?utm_medium=api&utm_source=custom_widget",
    image:
      "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1753932705l/238226942._SY75_.jpg",
  },
  {
    title: "The God of Carnage",
    author: "Yasmina Reza",
    href: "https://www.goodreads.com/review/show/8748489569?utm_medium=api&utm_source=custom_widget",
    image:
      "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1347752275l/3070605._SY75_.jpg",
  },
];
---

<section class="reading-shelf" aria-labelledby="reading-heading">
  <h2 id="reading-heading" class="sr-only">Recently Read</h2>
  <div class="goodreads-shell">
      <div id="gr_custom_widget_1785276567">
        <div class="gr_custom_container_1785276566">
          <h2 class="gr_custom_header_1785276566">
            <a rel="nofollow" href={shelfUrl}>Nat's bookshelf: read</a>
          </h2>
          {
            fallbackBooks.map((book) => (
              <div class="gr_custom_each_container_1785276566">
                <div class="gr_custom_book_container_1785276566">
                  <a title={book.title} rel="nofollow" href={book.href}>
                    <img
                      alt={`Cover of ${book.title}`}
                      src={book.image}
                      width="50"
                      height="75"
                      loading="lazy"
                    />
                  </a>
                </div>
                <div class="gr_custom_title_1785276566">
                  <a rel="nofollow" href={book.href}>{book.title}</a>
                </div>
                <div class="gr_custom_author_1785276566">
                  by {book.author}
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <script is:inline src={widgetUrl}></script>
      <noscript>
        <p>
          <a href={shelfUrl}>See the books I've read recently on Goodreads.</a>
        </p>
      </noscript>
  </div>
  <a class="shelf-link" href={shelfUrl}>Full shelf ↗</a>
</section>

<style>
  .reading-shelf {
    margin-top: 0;
    padding-block: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .shelf-link {
    display: block;
    margin-top: 0.25rem;
    color: var(--foreground);
    font-size: 0.75rem;
    font-weight: 500;
    text-align: right;
  }

  .goodreads-shell {
    min-height: 2.75rem;
  }

  .goodreads-shell :global([class^="gr_custom_container_"]) {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 0.375rem 0.5rem !important;
    width: 100% !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    overflow: visible !important;
    background: transparent !important;
    color: var(--foreground) !important;
  }

  .goodreads-shell :global([class^="gr_custom_header_"]),
  .goodreads-shell :global([class^="gr_custom_container_"] > br),
  .goodreads-shell :global([class^="gr_custom_container_"] > center) {
    display: none !important;
  }

  .goodreads-shell :global([class^="gr_custom_each_container_"]) {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    width: auto !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    overflow: visible !important;
  }

  .goodreads-shell :global([class^="gr_custom_book_container_"]) {
    float: none !important;
    width: 2.5rem !important;
    height: 3.25rem !important;
    aspect-ratio: 5 / 7 !important;
    margin: 0 !important;
    overflow: hidden !important;
    border-radius: var(--radius) !important;
    background: var(--muted) !important;
  }

  .goodreads-shell :global([class^="gr_custom_book_container_"] img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  .goodreads-shell :global([class^="gr_custom_title_"]) {
    display: -webkit-box !important;
    width: 100% !important;
    margin-top: 0.25rem !important;
    overflow: hidden !important;
    color: var(--foreground) !important;
    font-size: 0.7rem !important;
    font-weight: 700 !important;
    line-height: 1.1 !important;
    text-align: center !important;
    -webkit-box-orient: vertical !important;
    -webkit-line-clamp: 2 !important;
  }

  .goodreads-shell :global([class^="gr_custom_title_"] a),
  .goodreads-shell :global([class^="gr_custom_author_"] a) {
    color: var(--foreground) !important;
  }

  .goodreads-shell :global([class^="gr_custom_author_"]) {
    display: none !important;
  }

  .goodreads-shell :global([class^="gr_custom_tags_"]),
  .goodreads-shell :global([class^="gr_custom_rating_"]) {
    display: none !important;
  }

  noscript p {
    margin: 1rem 0 0;
  }

  @media (min-width: 901px) and (max-height: 700px) {
    .reading-shelf {
      padding-block: 0.5rem;
    }

    .goodreads-shell :global([class^="gr_custom_container_"]) {
      gap: 0.375rem !important;
    }

    .goodreads-shell :global([class^="gr_custom_book_container_"]) {
      width: 2rem !important;
      height: 2.5rem !important;
    }

    .goodreads-shell :global([class^="gr_custom_title_"]) {
      margin-top: 0.125rem !important;
      font-size: 0.625rem !important;
      white-space: nowrap !important;
      text-overflow: ellipsis !important;
      -webkit-line-clamp: 1 !important;
    }
  }
</style>
