---
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import FormattedDate from "./FormattedDate.astro";
import type { BlueskyPost } from "@/lib/bluesky";

interface Props {
  post: BlueskyPost;
}

const { post } = Astro.props;
const firstLine =
  post.text
    .split("\n")
    .map((line) => line.trim())
    .find(Boolean) || "Bluesky post";
const title =
  firstLine.length > 110 ? `${firstLine.slice(0, 109).trimEnd()}…` : firstLine;
---

<Card className="post-card bluesky-post-card">
  <CardHeader>
    <CardTitle role="heading" aria-level={2}>
      <a href={post.url}>{title}</a>
    </CardTitle>
    <CardDescription>
      Posted <FormattedDate date={post.createdAt} /> · Bluesky
    </CardDescription>
  </CardHeader>
  <CardContent>
    <article class="post-content bluesky-content" lang={post.lang}>
      <p class="bluesky-text">{post.text}</p>
      {
        post.images.length ? (
          <div class={`bluesky-images count-${Math.min(post.images.length, 4)}`}>
            {post.images.slice(0, 4).map((image) => (
              <a href={post.url} class="bluesky-image-link">
                <img
                  src={image.thumb}
                  alt={image.alt || "Image from Bluesky post"}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))}
          </div>
        ) : null
      }
      {
        post.external ? (
          <a class="bluesky-external" href={post.external.uri} rel="noopener noreferrer">
            {post.external.thumb ? (
              <img
                src={post.external.thumb}
                alt=""
                loading="lazy"
                decoding="async"
              />
            ) : null}
            <span class="bluesky-external-copy">
              <span class="bluesky-external-title">{post.external.title}</span>
              {post.external.description ? (
                <span class="bluesky-external-desc">{post.external.description}</span>
              ) : null}
            </span>
          </a>
        ) : null
      }
    </article>
  </CardContent>
  <CardFooter className="px-(--card-spacing) pb-(--card-spacing)">
    <a class="bluesky-permalink" href={post.url}>View on Bluesky →</a>
  </CardFooter>
</Card>

<style>
  .bluesky-post-card {
    width: 100%;
  }

  .bluesky-post-card :global(a) {
    color: inherit;
  }

  .bluesky-content {
    max-width: none;
    width: 100%;
  }

  .bluesky-content :global(> :first-child) {
    margin-top: 0;
  }

  .bluesky-content :global(> :last-child) {
    margin-bottom: 0;
  }

  .bluesky-text {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .bluesky-images {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
    width: 100%;
  }

  .bluesky-images.count-1 {
    grid-template-columns: 1fr;
  }

  .bluesky-images.count-2,
  .bluesky-images.count-3,
  .bluesky-images.count-4 {
    grid-template-columns: 1fr 1fr;
  }

  .bluesky-image-link {
    display: block;
    overflow: hidden;
    border-radius: calc(var(--radius) * 0.85);
    border: 1px solid var(--border);
    background: var(--muted);
  }

  .bluesky-image-link img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 22rem;
    object-fit: cover;
  }

  .bluesky-external {
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    gap: 1rem;
    margin-top: 1rem;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 0.85);
    text-decoration: none;
    background: var(--muted);
  }

  .bluesky-external img {
    flex: 0 0 9rem;
    width: 9rem;
    height: 9rem;
    object-fit: cover;
    border-radius: 0;
  }

  .bluesky-external-copy {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    min-width: 0;
    padding: 0.9rem 1rem 0.9rem 0;
  }

  .bluesky-external:not(:has(img)) .bluesky-external-copy {
    padding: 0.9rem 1rem;
  }

  .bluesky-external-title {
    font-weight: 600;
    line-height: 1.35;
  }

  .bluesky-external-desc {
    color: var(--muted-foreground);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .bluesky-permalink {
    font-weight: 500;
  }

  @media (max-width: 600px) {
    .bluesky-external {
      flex-direction: column;
    }

    .bluesky-external img {
      flex-basis: auto;
      width: 100%;
      height: 10rem;
    }

    .bluesky-external-copy {
      padding: 0.85rem 1rem 1rem;
    }
  }
</style>
