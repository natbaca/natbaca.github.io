---
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  slug: string;
  title: string;
  publishedAt: Date;
  updatedDate?: Date;
}

const {
  slug,
  title,
  publishedAt,
  updatedDate,
} = Astro.props;
---

<Card className="post-card">
  <CardHeader>
    <CardTitle role="heading" aria-level={2}>
      <a href={`/blog/${slug}/`}>{title}</a>
    </CardTitle>
    <CardDescription>
      {
        updatedDate ? (
          <>Updated <FormattedDate date={updatedDate} /></>
        ) : (
          <>Published <FormattedDate date={publishedAt} /></>
        )
      }
    </CardDescription>
  </CardHeader>
  <CardContent>
    <article class="post-content">
      <slot />
    </article>
  </CardContent>
</Card>

<style>
  .post-card a {
    color: inherit;
  }

  .post-content :global(> :first-child) {
    margin-top: 0;
  }

  .post-content :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
