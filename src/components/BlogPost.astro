---
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import FormattedDate from "./FormattedDate.astro";
import PostTags from "./PostTags.astro";
import type { Tag } from "../content.config";

interface Props {
  slug: string;
  title: string;
  publishedAt: Date;
  updatedDate?: Date;
  tags: Tag[];
}

const { slug, title, publishedAt, updatedDate, tags } = Astro.props;
---

<Card className="post-card">
  <CardHeader>
    <CardTitle role="heading" aria-level={3}>
      <a href={`/blog/${slug}/`}>{title}</a>
    </CardTitle>
    <CardDescription>
      {
        updatedDate ? (
          <>
            Updated <FormattedDate date={updatedDate} />
          </>
        ) : (
          <>
            Published <FormattedDate date={publishedAt} />
          </>
        )
      }
    </CardDescription>
  </CardHeader>
  <CardContent>
    <article class="post-content">
      <slot />
    </article>
    <PostTags tags={tags} label={`Tags for ${title}`} />
  </CardContent>
</Card>

<style>
  .post-card :global([data-slot="card-title"]) a {
    color: var(--foreground);
    text-decoration: none;
  }

  .post-card :global([data-slot="card-title"]) a:hover,
  .post-card :global([data-slot="card-title"]) a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
