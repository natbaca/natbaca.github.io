---
interface Props {
	date?: Date | string;
}

const { date } = Astro.props;
const parsedDate =
	date instanceof Date ? date : date ? new Date(date) : undefined;
const validDate =
	parsedDate && !Number.isNaN(parsedDate.valueOf()) ? parsedDate : undefined;
const formatter = new Intl.DateTimeFormat('en', { dateStyle: 'long' });
---

{validDate ? (
	<time datetime={validDate.toISOString()}>{formatter.format(validDate)}</time>
) : null}
