---
const socialLinks = [
  {
    href: "https://www.linkedin.com/in/natbaca/",
    label: "LinkedIn",
    icon: "fab fa-linkedin",
  },
  {
    href: "https://github.com/natbaca",
    label: "GitHub",
    icon: "fab fa-github",
  },
  {
    href: "https://en.wikipedia.org/wiki/User:NatBaca",
    label: "Wikipedia",
    icon: "fab fa-wikipedia-w",
  },
  {
    href: "https://www.goodreads.com/user/show/12688292-nat-baca",
    label: "Goodreads",
    icon: "fab fa-goodreads",
  },
  {
    href: "https://www.duolingo.com/profile/natkbaca",
    label: "Duolingo",
    icon: "fa-brands fa-earlybirds",
  },
  {
    href: "https://www.instagram.com/natural_light_official/",
    label: "Instagram",
    icon: "fa-brands fa-instagram",
  },
  {
    href: "https://bsky.app/profile/natbaca.bsky.social",
    label: "Bluesky",
    icon: "fa-brands fa-bluesky",
  },
];
---

<nav class="social-links" aria-labelledby="socials-heading">
  <h2 id="socials-heading" class="sr-only">Socials</h2>
  <ul>
    {
      socialLinks.map((link) => (
        <li>
          <a href={link.href} aria-label={link.label}>
            <i class={link.icon} />
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .social-links ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .social-links a {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background: var(--secondary);
    color: var(--foreground);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .social-links a:hover,
  .social-links a:focus-visible {
    background: var(--accent);
    border-color: transparent;
    transform: translateY(-1px);
  }

  .social-links a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
</style>
