---
const socialLinks = [
  {
    href: "https://www.linkedin.com/in/natbaca/",
    label: "LinkedIn",
    icon: "fab fa-linkedin",
  },
  {
    href: "https://github.com/natbaca",
    label: "GitHub",
    icon: "fab fa-github",
  },
  {
    href: "https://en.wikipedia.org/wiki/User:NatBaca",
    label: "Wikipedia",
    icon: "fab fa-wikipedia-w",
  },
  {
    href: "https://www.goodreads.com/user/show/12688292-nat-baca",
    label: "Goodreads",
    icon: "fab fa-goodreads",
  },
  {
    href: "https://www.duolingo.com/profile/natkbaca",
    label: "Duolingo",
    icon: "fa-brands fa-earlybirds",
  },
  {
    href: "https://www.instagram.com/natural_light_official/",
    label: "Instagram",
    icon: "fa-brands fa-instagram",
  },
  {
    href: "https://bsky.app/profile/natbaca.bsky.social",
    label: "Bluesky",
    icon: "fa-brands fa-bluesky",
  },
];
---

<nav class="social-links" aria-labelledby="socials-heading">
  <h2 id="socials-heading" class="sr-only">Socials</h2>
  <ul>
    {
      socialLinks.map((link) => (
        <li>
          <a href={link.href} aria-label={link.label}>
            <i class={link.icon} />
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .social-links {
    display: block;
    margin-top: 0;
    padding: 0.75rem 0;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 901px) and (max-height: 700px) {
    .social-links {
      padding-block: 0.5rem;
    }
  }

  .social-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    width: auto;
    flex-wrap: nowrap;
    gap: 0.375rem;
    justify-content: center;
  }

  .social-links li {
    display: inline-flex;
  }

  .social-links a {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--secondary-foreground);
    background: var(--secondary);
    border: 1px solid var(--border);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .social-links a:hover,
  .social-links a:focus-visible {
    color: var(--accent-foreground);
    background: var(--accent);
  }

  .social-links a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
</style>
