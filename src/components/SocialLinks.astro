---
const socialLinks = [
  {
    href: "https://www.linkedin.com/in/natbaca/",
    label: "LinkedIn",
    icon: "fab fa-linkedin",
  },
  {
    href: "https://github.com/natbaca",
    label: "GitHub",
    icon: "fab fa-github",
  },
  {
    href: "https://en.wikipedia.org/wiki/User:NatBaca",
    label: "Wikipedia",
    icon: "fab fa-wikipedia-w",
  },
  {
    href: "https://www.goodreads.com/user/show/12688292-nat-baca",
    label: "Goodreads",
    icon: "fab fa-goodreads",
  },
  {
    href: "https://www.duolingo.com/profile/natkbaca",
    label: "Duolingo",
    icon: "fa-brands fa-earlybirds",
  },
  {
    href: "https://www.instagram.com/natural_light_official/",
    label: "Instagram",
    icon: "fa-brands fa-instagram",
  },
];
---

<nav class="social-links" aria-labelledby="socials-heading">
  <h2 id="socials-heading" class="social-links-heading">Find me elsewhere</h2>
  <ul>
    {
      socialLinks.map((link) => (
        <li>
          <a href={link.href}>
            <i class={link.icon} aria-hidden="true" />
            <span>{link.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .social-links-heading {
    margin: 0 0 0.6rem;
    color: var(--muted-foreground);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .social-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background: var(--card);
    color: var(--foreground);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    box-shadow: 0 1px 2px oklch(0.2 0.02 70 / 0.05);
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .social-links a :global(svg),
  .social-links a i {
    flex: 0 0 auto;
    width: 1.05rem;
    font-size: 1.05rem;
    text-align: center;
  }

  .social-links a:hover,
  .social-links a:focus-visible {
    background: var(--accent);
    border-color: var(--ring);
    box-shadow: 0 2px 6px oklch(0.2 0.02 70 / 0.1);
    transform: translateY(-1px);
  }

  .social-links a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .social-links a {
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }
  }
</style>
