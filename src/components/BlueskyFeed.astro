---
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";

const handle = "natbaca.bsky.social";
const profileUrl = `https://bsky.app/profile/${handle}`;
---

<Card className="bluesky-section gap-0">
  <CardHeader className="px-6">
    <CardTitle role="heading" aria-level={2}>From Bluesky</CardTitle>
  </CardHeader>
  <CardContent className="min-h-0 flex-1 px-6">
    <bsky-embed
      username={handle}
      limit="5"
      mode="light"
      link-target="_blank"
      disable-images="true"
      disable-videos="true"
      disable-autoplay="true"
      load-more="false"
      custom-styles={`
        section {
          height: 100%;
        }

        section > div.w-full {
          display: flex;
          flex: 1;
          min-height: 0;
        }

        article {
          display: flex;
          align-items: center;
          width: 100%;
          height: 100%;
          position: relative;
          padding: 0.5rem 0 !important;
          box-sizing: border-box;
          cursor: pointer;
        }

        article > div.flex {
          width: 100%;
          gap: 0 !important;
        }

        article > div.flex > img {
          display: none !important;
        }

        article > div.flex > div {
          max-width: 100% !important;
        }

        article > div.flex > div > div.flex.items-center {
          display: flex !important;
          width: 100%;
          min-height: 1rem;
          margin-bottom: 0.2rem;
        }

        article > div.flex > div > div.flex.items-center > a:first-child,
        article > div.flex > div > div.flex.items-center > span:not(:last-child),
        article > div.flex > div > div.flex.items-center > span:last-child > span {
          display: none !important;
        }

        article > div.flex > div > div.flex.items-center > span:last-child {
          display: block !important;
          width: 100%;
          margin: 0 !important;
          color: #64748b;
          font-size: 0.75rem;
          line-height: 1;
        }

        article > div.flex > div > div.flex.items-center > span:last-child a {
          display: flex;
          justify-content: space-between;
          width: 100%;
        }

        article > div.flex > div > div.flex.items-center > span:last-child a::after {
          content: "Open post ↗";
        }

        article > div.flex > div > div.flex.items-center > span:last-child a::before {
          position: absolute;
          z-index: 1;
          inset: 0;
          content: "";
        }

        article p.whitespace-pre-wrap {
          display: -webkit-box;
          overflow: hidden;
          font-size: 0.9rem;
          line-height: 1.3;
          -webkit-box-orient: vertical;
          -webkit-line-clamp: 4;
          pointer-events: none;
        }

        article a.mt-4 {
          display: none !important;
        }

        @media (max-height: 700px) {
          article {
            padding: 0.25rem 0 !important;
          }

          article p.whitespace-pre-wrap {
            font-size: 0.85rem;
            line-height: 1.25;
            -webkit-line-clamp: 3;
          }
        }
      `}
    >
      <p class="feed-status" role="status">Loading recent posts…</p>
    </bsky-embed>
    <noscript>
      <p class="feed-status">
        <a href={profileUrl}>Read the latest posts on Bluesky.</a>
      </p>
    </noscript>
  </CardContent>
  <CardFooter className="mt-auto px-6 py-4">
    <a href={profileUrl}>Browse all posts on Bluesky →</a>
  </CardFooter>
</Card>

<script>
  import "../../node_modules/bsky-embed/dist/bsky-embed.es.js";
</script>

<style>
  .bluesky-section a {
    color: var(--foreground);
    font-weight: 500;
  }

  bsky-embed {
    display: block;
    height: 100%;
    min-height: 0;
  }

  .feed-status {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 1rem;
  }
</style>
