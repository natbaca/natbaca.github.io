---
import { Image } from "astro:assets";
import SocialLinks from "./SocialLinks.astro";
import headshot from "../assets/headshot.png";

interface Props {
  headingLevel?: 1 | 2;
}

const { headingLevel = 2 } = Astro.props;
---

<header class="site-header">
  <div class="masthead">
    <Image
      class="profile-headshot"
      src={headshot}
      width={160}
      height={160}
      alt="Nat Baca"
    />
    <div class="masthead-copy">
      {headingLevel === 1 ? <h1>Nat Baca</h1> : <h2>Nat Baca</h2>}
      <p class="profile-tagline">I'm interested in everything.</p>
    </div>
    <SocialLinks />
  </div>

  <section class="about-bio" aria-labelledby="about-heading">
    <h2 id="about-heading" class="sr-only">About</h2>
    <p>
      By day, I'm a <a href="https://linkedin.com/in/natbaca"
        >Director of Engineering</a
      > at the{" "}
      <a href="https://wikimediafoundation.org">Wikimedia Foundation</a>. By
      night, I'm a host of{" "}
      <a href="https://albuquerque.nerdnite.com">Nerd Nite Albuquerque</a>. I've
      worked for <a href="https://www.apple.com/">Apple</a>,{" "}
      <a href="https://www.spotify.com/">Spotify</a>, the{" "}
      <a href="https://www.usds.gov/">White House</a>, and{" "}
      <a href="https://www.linkedin.com/in/natbaca/">more</a>. I like to{" "}
      <a href="https://www.goodreads.com/user/show/12688292-nat-baca">read</a>,{
        " "
      }
      <a href="https://en.wikipedia.org/wiki/User:NatBaca">write</a>, and{" "}
      <a href="https://github.com/natbaca">code</a>.
    </p>
  </section>
</header>

<style>
  .site-header {
    display: grid;
    gap: 0.85rem;
    padding: 1rem 1.35rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      radial-gradient(
        120% 80% at 0% 0%,
        oklch(0.96 0.02 185 / 0.45),
        transparent 55%
      ),
      var(--card);
  }

  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.1rem;
  }

  .profile-headshot {
    flex: 0 0 auto;
    width: 5rem;
    height: 5rem;
    object-fit: cover;
    border-radius: 9999px;
  }

  .masthead-copy {
    flex: 1 1 10rem;
    min-width: 0;
  }

  .masthead h1,
  .masthead h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.15rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .profile-tagline {
    margin: 0.15rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .masthead :global(.social-links) {
    flex: 0 0 auto;
    margin-left: auto;
    padding: 0;
    border: 0;
  }

  .masthead :global(.social-links ul) {
    justify-content: flex-end;
  }

  .about-bio p {
    max-width: none;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.6;
  }

  .about-bio a {
    color: var(--foreground);
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .site-header {
      padding: 0.9rem 1rem 1rem;
    }

    .masthead :global(.social-links) {
      flex-basis: 100%;
      margin-left: 0;
    }

    .masthead :global(.social-links ul) {
      justify-content: flex-start;
    }

    .profile-headshot {
      width: 4.25rem;
      height: 4.25rem;
    }

    .about-bio p {
      max-width: none;
    }
  }
</style>
