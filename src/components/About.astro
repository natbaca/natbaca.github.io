---
import { Image } from "astro:assets";
import { Card, CardContent } from "@/components/ui/card";
import GoodreadsWidget from "./GoodreadsWidget.astro";
import SocialLinks from "./SocialLinks.astro";
import headshot from "../assets/headshot.png";

interface Props {
  headingLevel?: 1 | 2;
}

const { headingLevel = 2 } = Astro.props;
---

<Card className="about-column py-0">
  <CardContent className="about-content grid h-full py-0">
    <section class="profile-summary">
      <Image
        class="profile-headshot"
        src={headshot}
        width={320}
        height={320}
        alt="Nat Baca"
      />
      <div>
        {
          headingLevel === 1 ? (
            <h1>Hi, I'm Nat Baca</h1>
          ) : (
            <h2>Hi, I'm Nat Baca</h2>
          )
        }
        <p>I'm interested in everything.</p>
      </div>
    </section>
    <section class="about-bio" aria-labelledby="about-heading">
      <h2 id="about-heading" class="sr-only">About</h2>
      <ul class="about-list">
        <li>
          By day, I'm a Director of Engineering at the{" "}
          <a href="https://wikimediafoundation.org">Wikimedia Foundation</a>.
        </li>
        <li>
          By night, I'm a host of{" "}
          <a href="https://albuquerque.nerdnite.com">Nerd Nite Albuquerque</a>.
        </li>
        <li>
          I've worked for <a href="https://www.apple.com/">Apple</a>,{" "}
          <a href="https://www.spotify.com/">Spotify</a>, the{" "}
          <a href="https://www.usds.gov/">White House</a>, and{" "}
          <a href="https://www.linkedin.com/in/natbaca/">more</a>.
        </li>
        <li>
          I like to{" "}
          <a href="https://www.goodreads.com/user/show/12688292-nat-baca"
            >read</a
          >,{" "}
          <a href="https://en.wikipedia.org/wiki/User:NatBaca">write</a>, and{" "}
          <a href="https://github.com/natbaca">code</a>.
        </li>
      </ul>
    </section>
    <GoodreadsWidget />
    <SocialLinks />
  </CardContent>
</Card>

<style>
  :global(.about-column) {
    height: 100%;
    max-height: 100%;
  }

  :global(.about-column .about-content) {
    grid-template-rows: auto minmax(auto, 1fr) auto auto;
  }

  .profile-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .profile-headshot {
    flex: 0 0 auto;
    width: 8rem;
    height: 8rem;
    object-fit: cover;
    border-radius: 9999px;
  }

  .profile-summary h1,
  .profile-summary h2 {
    margin: 0;
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .profile-summary p {
    margin: 0.25rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    line-height: 1.25;
  }

  .about-bio {
    padding-block: 0.75rem;
  }

  .about-list {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding-left: 1rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .about-list a {
    color: var(--foreground);
    font-weight: 500;
  }

  @media (min-width: 901px) and (max-height: 700px) {
    .profile-headshot {
      width: 5rem;
      height: 5rem;
    }

    .profile-summary h1,
    .profile-summary h2 {
      font-size: 1.25rem;
    }

    .profile-summary,
    .about-bio {
      padding-block: 0.5rem;
    }

    .about-list {
      gap: 0.2rem;
      font-size: 0.875rem;
      line-height: 1.2;
    }
  }

  @media (min-width: 901px) and (min-height: 850px) {
    .profile-summary {
      flex-direction: column;
      align-items: flex-start;
    }

    .profile-headshot {
      width: 9.5rem;
      height: 9.5rem;
    }

    .profile-summary h1,
    .profile-summary h2 {
      font-size: 1.75rem;
    }
  }
</style>
