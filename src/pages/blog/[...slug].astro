---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import About from "../../components/About.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import PostTags from "../../components/PostTags.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="site-shell post-page">
    <About />
    <Card className="post-detail">
      <CardHeader>
        <a class="post-back" href="/">← Back</a>
        <CardTitle className="text-3xl" role="heading" aria-level={1}>
          {post.data.title}
        </CardTitle>
        <p class="post-meta">
          {
            post.data.updatedDate ? (
              <>
                Updated <FormattedDate date={post.data.updatedDate} />
              </>
            ) : (
              <>
                Published <FormattedDate date={post.data.publishedAt} />
              </>
            )
          }
        </p>
      </CardHeader>
      <CardContent>
        <article class="post-content">
          <Content />
        </article>
        <PostTags tags={post.data.tags} />
      </CardContent>
    </Card>
  </div>
</BaseLayout>

<style>
  .post-back {
    display: inline-block;
    margin-bottom: 0.65rem;
    font-weight: 600;
  }
</style>
