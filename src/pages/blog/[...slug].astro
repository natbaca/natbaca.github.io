---
import BaseLayout from "../../layouts/BaseLayout.astro";
import About from "../../components/About.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="split-layout">
    <About />
    <section class="content-column" aria-label="Post">
      <Card className="post-detail">
        <CardHeader>
          <a class="post-back" href="/">← Back to the list</a>
          <CardTitle className="text-3xl" role="heading" aria-level={1}>
            {post.data.title}
          </CardTitle>
          <p class="post-meta">
            {
              post.data.updatedDate ? (
                <>Updated <FormattedDate date={post.data.updatedDate} /></>
              ) : (
                <>Published <FormattedDate date={post.data.publishedAt} /></>
              )
            }
          </p>
        </CardHeader>
        <CardContent>
          <article class="post-full">
            <div class="post-content">
              <Content />
            </div>
          </article>
        </CardContent>
      </Card>
    </section>
  </div>
</BaseLayout>

<style>
  .post-full {
    padding: 0;
  }

  .post-back {
    display: inline-block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .post-content {
    margin-top: 0.5rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.2rem;
  }
</style>
