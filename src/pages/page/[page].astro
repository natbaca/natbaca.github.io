---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostFeedPage from "../../components/PostFeedPage.astro";
import {
  getRenderedPosts,
  PAGE_SIZE,
  summarizeTags,
  totalPages,
  type RenderedPost,
  type TagSummary,
} from "../../lib/posts";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

interface Props {
  posts: RenderedPost[];
  currentPage: number;
  totalPages: number;
  tags: TagSummary[];
  totalPosts: number;
}

export const getStaticPaths = (async () => {
  const posts = await getRenderedPosts();
  const pageCount = totalPages(posts.length);
  const tags = summarizeTags(posts);

  // Page 1 lives at `/`, so this route only covers pages 2 and up.
  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => {
    const currentPage = index + 2;
    const start = (currentPage - 1) * PAGE_SIZE;

    return {
      params: { page: String(currentPage) },
      props: {
        posts: posts.slice(start, start + PAGE_SIZE),
        currentPage,
        totalPages: pageCount,
        tags,
        totalPosts: posts.length,
      },
    };
  });
}) satisfies GetStaticPaths;

const {
  posts,
  currentPage,
  totalPages: pageCount,
  tags,
  totalPosts,
} = Astro.props;
const previousUrl = currentPage === 2 ? "/" : `/page/${currentPage - 1}/`;
const nextUrl = currentPage < pageCount ? `/page/${currentPage + 1}/` : undefined;
---

<BaseLayout
  title={`Posts — Page ${currentPage} | ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
>
  <PostFeedPage
    posts={posts}
    currentPage={currentPage}
    totalPages={pageCount}
    previousUrl={previousUrl}
    nextUrl={nextUrl}
    tags={tags}
    totalPosts={totalPosts}
  />
</BaseLayout>
