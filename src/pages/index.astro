---
import BaseLayout from "../layouts/BaseLayout.astro";
import CombinedFeedPage from "../components/CombinedFeedPage.astro";
import { getCombinedFeed } from "../lib/feed";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const feed = await getCombinedFeed();
const pageSize = 10;
const totalPages = Math.max(1, Math.ceil(feed.length / pageSize));
const pageFeed = feed.slice(0, pageSize);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <CombinedFeedPage
    feed={pageFeed}
    currentPage={1}
    totalPages={totalPages}
    nextUrl={totalPages > 1 ? "/page/2/" : undefined}
  />
</BaseLayout>
