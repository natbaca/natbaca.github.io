---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "../components/About.astro";
import BlueskyFeed from "../components/BlueskyFeed.astro";
import BlogPost from "../components/BlogPost.astro";
import { getCollection, render } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const renderedPosts = await Promise.all(
  posts.map(async (post) => ({
    post,
    Content: (await render(post)).Content,
  }))
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="split-layout">
    <About headingLevel={1} />
    <section class="content-column" aria-label="Writing">
      <div class="content-list">
        {
          renderedPosts.length ? (
            renderedPosts.map(({ post, Content }) => (
              <BlogPost
                slug={post.id}
                title={post.data.title}
                publishedAt={post.data.publishedAt}
                updatedDate={post.data.updatedDate}
              >
                <Content />
              </BlogPost>
            ))
          ) : (
            <div class="empty-posts" role="status">
              <h2>Writing in progress</h2>
              <p>Check back soon for the first entry.</p>
            </div>
          )
        }
      </div>
    </section>
    <aside class="social-column" aria-label="Bluesky posts">
      <BlueskyFeed />
    </aside>
  </div>
</BaseLayout>

<style>
  .social-column {
    min-width: 0;
  }

  .social-column :global([data-slot="card"]) {
    width: 100%;
  }

  @media (max-width: 900px) {
    .social-column {
      grid-column: auto;
    }
  }
</style>
