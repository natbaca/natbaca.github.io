{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Astro: Install Dependencies",
      "type": "shell",
      "command": "npx --yes --package=node@24 --package=pnpm@10.8.1 --call 'pnpm install --frozen-lockfile && pnpm exec astro sync'",
      "problemMatcher": []
    },
    {
      "label": "Astro: Development Server",
      "type": "shell",
      "command": "ASTRO_DEV_BACKGROUND=0 npx --yes --package=node@24 --package=pnpm@10.8.1 --call 'pnpm run dev --host 127.0.0.1'",
      "dependsOn": "Astro: Install Dependencies",
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "astro",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*astro dev.*",
          "endsPattern": ".*Local.*http://127\\.0\\.0\\.1:4321.*"
        }
      }
    },
    {
      "label": "GitHub Pages: Install & Build",
      "type": "shell",
      "command": "npx --yes --package=node@24 --package=pnpm@10.8.1 --call 'pnpm install --frozen-lockfile && pnpm run build'",
      "problemMatcher": []
    },
    {
      "label": "GitHub Pages: Preview",
      "type": "shell",
      "command": "npx --yes --package=node@24 --package=pnpm@10.8.1 --call 'pnpm run preview --host 127.0.0.1'",
      "dependsOn": "GitHub Pages: Install & Build",
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "astro",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*astro preview.*",
          "endsPattern": ".*Local.*http://127\\.0\\.0\\.1:4321.*"
        }
      }
    }
  ]
}
